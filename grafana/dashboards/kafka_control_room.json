          "rawQuery": true,
          "rawSql": "SELECT event_time AS \"Time\", alert_severity AS \"Severity\", machine_id AS \"Machine\", line_id AS \"Line\", event_type AS \"Event Type\", status AS \"Event Status\", CASE WHEN event_type = 'print_failed' THEN 'Inspect QR printer, ink, line jam, and scanner alignment' WHEN event_type = 'machine_warning' THEN 'Check sensor reading and machine condition' WHEN temperature >= 85 THEN 'Inspect cooling and reduce load if needed' WHEN temperature >= 75 THEN 'Watch temperature trend and inspect ventilation' ELSE 'Review event context' END AS \"Suggested Action\", alert_reason AS \"Reason\", temperature AS \"Temp C\", speed AS \"Speed\", error_code AS \"Error Code\" FROM control_room_alert_feed WHERE event_time >= NOW() - INTERVAL '60 minutes' AND machine_id IN (${machine:sqlstring}) AND line_id IN (${line:sqlstring}) ORDER BY event_time DESC LIMIT 100;",
