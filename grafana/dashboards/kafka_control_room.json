        {
          "datasource": {
            "type": "postgres",
            "uid": "machine_monitoring_postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH line_metrics AS (SELECT line_id, COUNT(*) AS events_15m, COUNT(*) FILTER (WHERE status = 'failed') AS failed_15m, COUNT(*) FILTER (WHERE status = 'warning') AS warnings_15m, COALESCE(ROUND(COUNT(*) FILTER (WHERE status = 'failed')::NUMERIC / NULLIF(COUNT(*), 0) * 100, 2), 0) AS failure_rate_pct, ROUND(AVG(temperature), 2) AS avg_temp_c, ROUND(AVG(speed), 2) AS avg_speed, MAX(event_time) AS latest_event FROM machine_events_raw WHERE event_time >= NOW() - INTERVAL '15 minutes' AND machine_id IN (${machine:sqlstring}) AND line_id IN (${line:sqlstring}) GROUP BY line_id), alert_metrics AS (SELECT line_id, COUNT(*) FILTER (WHERE alert_severity = 'CRITICAL' AND event_time >= NOW() - INTERVAL '15 minutes') AS critical_15m FROM control_room_alert_feed WHERE machine_id IN (${machine:sqlstring}) AND line_id IN (${line:sqlstring}) GROUP BY line_id) SELECT m.line_id AS \"Line\", CASE WHEN m.events_15m = 0 THEN 'NO_DATA' WHEN m.failure_rate_pct >= 10 OR m.warnings_15m >= 10 OR m.avg_temp_c >= 85 THEN 'CRITICAL' WHEN m.failure_rate_pct >= 5 OR m.warnings_15m >= 5 OR m.avg_temp_c >= 75 THEN 'WARNING' ELSE 'NORMAL' END AS \"State\", m.events_15m AS \"Events 15m\", m.failed_15m AS \"Failed 15m\", m.warnings_15m AS \"Warnings 15m\", m.failure_rate_pct AS \"Failure %\", COALESCE(a.critical_15m, 0) AS \"Critical 15m\", m.avg_temp_c AS \"Avg Temp C\", m.avg_speed AS \"Avg Speed\", m.latest_event AS \"Latest Event\" FROM line_metrics m LEFT JOIN alert_metrics a ON a.line_id = m.line_id ORDER BY CASE WHEN m.failure_rate_pct >= 10 OR m.warnings_15m >= 10 OR m.avg_temp_c >= 85 THEN 1 WHEN m.failure_rate_pct >= 5 OR m.warnings_15m >= 5 OR m.avg_temp_c >= 75 THEN 2 ELSE 3 END, m.line_id;",
          "refId": "A"
        }
      ],
      "title": "Production Line KPI 15m",
      "type": "table"
