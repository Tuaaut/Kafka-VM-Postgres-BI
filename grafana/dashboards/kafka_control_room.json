          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT machine_id AS \"Machine\", line_id AS \"Line\", CASE WHEN COUNT(*) FILTER (WHERE status = 'failed') >= 3 OR ROUND(AVG(temperature), 2) >= 85 THEN 'CRITICAL' WHEN COUNT(*) FILTER (WHERE status = 'warning') >= 3 OR ROUND(AVG(temperature), 2) >= 75 THEN 'WARNING' ELSE 'NORMAL' END AS \"State\", COUNT(*) AS \"Events 15m\", COUNT(*) FILTER (WHERE status = 'failed') AS \"Failed 15m\", COUNT(*) FILTER (WHERE status = 'warning') AS \"Warnings 15m\", ROUND(AVG(temperature), 2) AS \"Temp C\", ROUND(AVG(speed), 2) AS \"Speed\", MAX(event_time) AS \"Latest Event\" FROM machine_events_raw WHERE event_time >= NOW() - INTERVAL '15 minutes' AND machine_id IN (${machine:sqlstring}) AND line_id IN (${line:sqlstring}) GROUP BY machine_id, line_id ORDER BY CASE WHEN COUNT(*) FILTER (WHERE status = 'failed') >= 3 OR ROUND(AVG(temperature), 2) >= 85 THEN 1 WHEN COUNT(*) FILTER (WHERE status = 'warning') >= 3 OR ROUND(AVG(temperature), 2) >= 75 THEN 2 ELSE 3 END, machine_id, line_id;",
          "refId": "A"
        }
      ],
      "title": "Machine Board 15m",
      "type": "table"
