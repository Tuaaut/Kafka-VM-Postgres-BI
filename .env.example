KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=machine_events
KAFKA_CONSUMER_GROUP=postgres-writer

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=machine_monitoring
POSTGRES_USER=monitoring_user
POSTGRES_PASSWORD=monitoring_password

# VM PostgreSQL snapshot export to Cloud Storage.
GCS_EXPORT_BUCKET=kafka-postgres-bi-exports-retail-bigquery-project-webapp
GCS_PREFIX=kafka-postgres-bi/exports
EXPORT_TIMEZONE=Asia/Bangkok

PRODUCER_EVENT_INTERVAL_SECONDS=60
PRODUCER_EVENTS_PER_BATCH=10
PRODUCER_MAX_BATCHES=

GRAFANA_URL=http://localhost:3000
GRAFANA_ROOT_URL=http://<VM_EXTERNAL_IP>:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Grafana email alerting through Gmail SMTP.
# Copy this file to .env or run scripts/configure_gmail_alerts.sh.
# Use a Gmail App Password, not your normal Gmail password.
GRAFANA_SMTP_ENABLED=false
GRAFANA_SMTP_HOST=smtp.gmail.com:587
GRAFANA_SMTP_USER=your-gmail-address@gmail.com
GRAFANA_SMTP_PASSWORD=your-16-character-gmail-app-password
GRAFANA_SMTP_FROM_ADDRESS=your-gmail-address@gmail.com
GRAFANA_SMTP_FROM_NAME=Kafka Monitoring Grafana
GRAFANA_SMTP_STARTTLS_POLICY=MandatoryStartTLS
GRAFANA_ALERT_EMAIL_TO=your-gmail-address@gmail.com

# LINE group-chat alerting.
# Keep LINE alerts low-volume to stay inside the free message quota.
# Use scripts/configure_line_alerts.sh to write real values to local .env.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# broadcast sends to all LINE Official Account friends and does not need LINE_TO_ID.
# push sends to one user/group/room ID and requires LINE_TO_ID.
LINE_SEND_MODE=broadcast
LINE_TO_ID=
LINE_ALERT_WEBHOOK_URL=http://line-alert-bridge:8080/grafana
LINE_MIN_SEVERITY=critical
LINE_DISABLE_RESOLVED=true
