          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH metrics AS (SELECT COUNT(*) AS total_events, COUNT(*) FILTER (WHERE status = 'failed') AS failed_events, COUNT(*) FILTER (WHERE status = 'warning') AS warning_events, ROUND(COUNT(*) FILTER (WHERE status = 'failed')::NUMERIC / NULLIF(COUNT(*), 0) * 100, 2) AS failure_rate_pct, ROUND(AVG(temperature), 2) AS avg_temperature, ROUND(EXTRACT(EPOCH FROM (MAX(ingest_time) - MAX(event_time)))::NUMERIC, 2) AS latest_lag_seconds FROM machine_events_raw WHERE event_time >= NOW() - INTERVAL '15 minutes' AND machine_id IN (${machine:sqlstring}) AND line_id IN (${line:sqlstring})) SELECT CASE WHEN total_events = 0 THEN 3 WHEN failure_rate_pct >= 10 OR warning_events >= 10 OR avg_temperature >= 85 OR latest_lag_seconds >= 300 THEN 2 WHEN failure_rate_pct >= 5 OR warning_events >= 5 OR avg_temperature >= 75 OR latest_lag_seconds >= 120 THEN 1 ELSE 0 END AS state FROM metrics;",
          "refId": "A"
        }
      ],
