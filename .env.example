# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
# .env is ignored by Git. Never commit real secrets (Gmail App Password,
# LINE channel access token/secret) or write them into Markdown docs.

# ---------------------------------------------------------------------------
# Local connection settings
# Used when running producer/consumer from the local .venv (manual fallback
# scripts). The Docker Compose services set their own values and do not read
# these, except where noted below.
# ---------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=machine_events
KAFKA_CONSUMER_GROUP=postgres-writer

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=machine_monitoring
POSTGRES_USER=monitoring_user
POSTGRES_PASSWORD=monitoring_password

# ---------------------------------------------------------------------------
# Producer settings
# ---------------------------------------------------------------------------
PRODUCER_EVENT_INTERVAL_SECONDS=60
PRODUCER_EVENTS_PER_BATCH=10
# Leave empty to run forever; set an integer to stop after N batches.
PRODUCER_MAX_BATCHES=
PRODUCER_SEED_EVENTS=true

# ---------------------------------------------------------------------------
# Grafana
# Root URL used for dashboard links in alert emails. For an operations-team
# or public demo, point this at the reachable VM address, e.g.
#   GRAFANA_ROOT_URL=http://136.110.54.120:3000
# ---------------------------------------------------------------------------
GRAFANA_ROOT_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Grafana SMTP / Gmail alerting
# Set GRAFANA_SMTP_ENABLED=true and fill in a Gmail address plus a Gmail
# App Password (not the normal password). Helper: scripts/configure_gmail_alerts.sh
# ---------------------------------------------------------------------------
GRAFANA_SMTP_ENABLED=false
GRAFANA_SMTP_HOST=smtp.gmail.com:587
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=
GRAFANA_SMTP_FROM_ADDRESS=grafana-alerts@example.invalid
GRAFANA_SMTP_FROM_NAME=Kafka Monitoring Grafana
GRAFANA_SMTP_STARTTLS_POLICY=MandatoryStartTLS
GRAFANA_ALERT_EMAIL_TO=grafana-alerts@example.invalid

# ---------------------------------------------------------------------------
# LINE alerting (fast mobile channel)
# Fill in the channel access token/secret from the LINE Official Account.
# Helper: scripts/configure_line_alerts.sh
#   LINE_SEND_MODE=broadcast  -> sends to all Official Account friends (no LINE_TO_ID needed)
#   LINE_SEND_MODE=push       -> requires LINE_TO_ID (userId, groupId, or roomId)
# ---------------------------------------------------------------------------
LINE_ALERT_WEBHOOK_URL=http://line-alert-bridge:8080/grafana
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_SEND_MODE=broadcast
LINE_TO_ID=
LINE_MIN_SEVERITY=critical
LINE_DISABLE_RESOLVED=true

# Dashboard URL used only by scripts/test_line_alert.sh for its sample payload.
GRAFANA_DASHBOARD_URL=http://136.110.54.120:3000/d/kafka-machine-monitoring/kafka-machine-monitoring-control-room
